+    if let Ok(wasm_headers) = std::env::var("DEP_TREE_SITTER_LANGUAGE_WASM_HEADERS") {
+        c_config.include(wasm_headers);
+    }
+
     #[cfg(target_env = "msvc")]
     c_config.flag("-utf-8");
 
