# Build artifacts
/target
**/target/
**/dist/

# Rust
**/*.rs.bk

# Local build overrides — e.g. a [patch] pointing rinch at a sibling checkout.
# Deliberately not committed: the manifest's pinned git rev is what everyone
# else builds against. See the README.
.cargo/config.toml

# IDE
.idea/
.vscode/
*.swp
*.swo

# AI tools
.claude/*
!.claude/settings.json
.mcp.json
# Browser-automation scratch output (screenshots, page snapshots, console logs)
.playwright-mcp/

# OS
.DS_Store
Thumbs.db
